# ------------------------------------------------------------
# CASE 404 — environment variables (copy to .env and adjust)
# cp .env.example .env
# ------------------------------------------------------------

# json-server API base URL
VITE_API_URL=http://localhost:3001

# n8n webhook. Enable n8n, import n8n/case404-workflow.json,
# activate the workflow, then set this URL.
# Replace the port if your n8n instance uses another one.
VITE_N8N_WEBHOOK_URL=http://localhost:5678/webhook/case-404

# ------------------------------------------------------------
# MOTOR DE IA — interrogatorio en tiempo real (opcional)
# Si VITE_AI_ENABLED es false (o falta), el juego usa el banco de
# respuestas offline (campo "interrogation") con idéntica experiencia.
# Compatible con cualquier API estilo OpenAI:
#   - Groq:        https://api.groq.com/openai/v1
#   - OpenAI:      https://api.openai.com/v1
#   - OpenRouter:  https://openrouter.ai/api/v1
# ------------------------------------------------------------
VITE_AI_ENABLED=false
VITE_AI_BASE_URL=https://api.groq.com/openai/v1
VITE_AI_KEY=pon-tu-clave-aqui
VITE_AI_MODEL=llama-3.3-70b-versatile
VITE_AI_TEMPERATURE=0.8